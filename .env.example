DATABASE_URL=
PORT=3000
NODE_ENV=development
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
REDIS_URL=redis://localhost:6379
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
MERCADOPAGO_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

TARIFA_BASE_HORA_CABA=3500
TARIFA_PICO_HORA_CABA=5000
TARIFA_BASE_KM_PROVINCIA=150
TARIFA_PICO_KM_PROVINCIA=200
DESVIO_UMBRAL_METROS=300
PARADA_SOSPECHOSA_MINUTOS=5
PARADA_SOSPECHOSA_VELOCIDAD_KMH=3
TEST_CONDUCTOR_TOKEN=
ETA_EMISOR_IDLE_SEGUNDOS=600
# REEMPLAZADA por VENTANA_INICIO_ANTES_MINUTOS (ver abajo). Solo sobrevive como
# fallback del iniciar LEGACY del marketplace si ANTES no esta definida.
VENTANA_INICIO_MINUTOS=120
PUNTUALIDAD_TARDE_MINUTOS=30
PUNTUALIDAD_MUY_TARDE_MINUTOS=120
# Minutos que una reserva de empresa puede quedar sin conductor asignado antes
# de volver sola al mercado. Cada reserva programa su propio temporizador (ya no
# hay job periodico que pollee la DB). Acepta fraccionarios: los tests usan 0.1
# (= 6 segundos) para no esperar minutos enteros.
RESERVA_TIMEOUT_MINUTOS=10
# Solo para tests. RESERVA_BARRIDO_ARRANQUE=0 desactiva el barrido de reservas
# del arranque, que de otro modo, en un server efimero con un
# RESERVA_TIMEOUT_MINUTOS chico, liberaria reservas reales de la DB compartida.
# En produccion NO se setea.
RESERVA_BARRIDO_ARRANQUE=1
RADIO_CONFIRMACION_METROS=50
# Anticipacion minima (en minutos) para la fecha_programada de un viaje nuevo.
# En staging/local se baja (o se pone en 0) para poder crear un viaje y
# debuggearlo al toque, sin esperar una hora. La fecha tiene que ser futura
# igual: con 0 el minimo pasa a ser "ahora", nunca se aceptan fechas pasadas.
ANTICIPACION_MINIMA_MINUTOS=60
# ── Identidad (Paso 1): invitaciones a PyMEs ──
# Secreto del HMAC-SHA256 con el que se guardan los codigos de invitacion (en la
# base NUNCA queda el codigo en claro). Si falta, el server arranca igual pero
# los endpoints de invitaciones responden 503. Mientras la DB de Neon este
# compartida entre staging y produccion tiene que ser el MISMO en los dos: con
# secretos distintos, un codigo creado en un environment daria "Codigo invalido"
# en el otro. Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITACION_SECRETO=
# Horas de vida de un codigo de invitacion (MIEMBRO o CHOFER).
INVITACION_VIGENCIA_HORAS=72
# Rate limit del canje (POST /api/invitaciones/canjear), por usuario Y por IP:
# INVITACION_INTENTOS_MAX intentos cada INVITACION_VENTANA_MINUTOS. Va en Redis;
# si Redis no responde se deja pasar y se loguea.
INVITACION_INTENTOS_MAX=5
INVITACION_VENTANA_MINUTOS=15
# Cuantas PyMEs ACTIVAS puede tener a la vez una cuenta CLIENTE. El schema
# permite varias; el limite es del servicio.
MAX_ORGANIZACIONES_POR_USUARIO=1
# ── Viaje interno (Paso 2) ──
# Ventana para iniciar un viaje de PyME: desde fecha_programada - ANTES hasta
# fecha_programada + DESPUES (viaje a las 10 -> 9:00 a 11:30 con 60/90). Pasado
# el fin de la ventana, un viaje ASIGNADO o CONFIRMADO VENCE (estado VENCIDO).
# Aceptan fraccionarios. Mientras la DB de Neon este compartida, tienen que valer
# LO MISMO en staging y produccion: los dos procesos vencen viajes de la misma DB.
VENTANA_INICIO_ANTES_MINUTOS=60
VENTANA_INICIO_DESPUES_MINUTOS=90
# Solo para tests. VENCIMIENTO_BARRIDO_ARRANQUE=0 desactiva el barrido de
# arranque de los viajes de PyME, que ESCRIBE (vence viajes) y arma timers con la
# ventana de ESTE proceso: un server efimero con una ventana de segundos venceria
# viajes reales de la DB compartida. En produccion NO se setea.
VENCIMIENTO_BARRIDO_ARRANQUE=1
# Marketplace dormido (default false): disponibles, crear por la ruta vieja,
# reservar/asignar/reasignar/cancelar-reserva, aceptar, empresas, afiliaciones y
# registro de gerente dan 404. Solo 'true' o '1' lo prenden.
MARKETPLACE_HABILITADO=false
# Calificaciones dormidas (default false): POST /api/viajes/:id/calificacion da 404.
CALIFICACIONES_HABILITADAS=false
# ── Test e2e ──
# Cuenta del e2e (mismos valores que los secrets de GitHub). La usan el e2e y
# scripts/seed-cuentas-test.js, que le arma la PyME y el chofer vinculado.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# ── Google Maps (Paso 3) ──
# GOOGLE_MAPS_API_KEY (arriba) tiene que tener habilitada Routes API. Toda
# llamada a Google pasa por src/services/maps/. Si Google falla, crear / editar /
# estimar responden 503 (o 400 si no hay ruta posible): nunca hay valores
# inventados.
# Tiempo de carga / descarga ("peon") que se estima en CADA parada. 0 es valido.
TIEMPO_PEON_MINUTOS=30
# Timeout de cada llamada a Google, en milisegundos.
MAPS_TIMEOUT_MS=8000
# routes (Routes API, default) | legacy (Directions API: rollback temporal; se
# borra cuando Routes lleve 1 a 2 semanas estable en produccion).
MAPS_PROVIDER=routes
