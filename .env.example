# Variables de entorno de Fleter (backend). Copiar a .env y completar.
# Cada una dice que hace y su DEFAULT EN EL CODIGO (lo que vale si no esta).
# Salvo que se diga otra cosa, se leen en CADA uso (no se cachean) y un valor
# basura o fuera de rango cae al default.
#
# Marcas:
#   [SOLO TESTS]  no se carga en Railway; la usan los scripts de test.
#   [LEGACY]      sirve al marketplace dormido (MARKETPLACE_HABILITADO=false).
#   [SCRIPT]      solo la lee un script manual de scripts/.
#
# Mientras la DB de Neon este COMPARTIDA entre staging y produccion, estas
# tienen que valer LO MISMO en los dos environments: INVITACION_SECRETO,
# VENTANA_INICIO_ANTES_MINUTOS, VENTANA_INICIO_DESPUES_MINUTOS (y conviene
# MAX_PARADAS_POR_VIAJE).

# ── Base de datos / servidor ────────────────────────────────────────────────
# Postgres (Neon). La lee Prisma (prisma/schema.prisma). Sin default.
DATABASE_URL=
# Puerto HTTP. Default 3000. En Railway lo inyecta la plataforma.
PORT=3000
# 'production' -> Prisma solo loguea errores; cualquier otro valor loguea cada
# query (prisma:query). Sin default (undefined = loguea todo).
NODE_ENV=development

# ── Firebase ────────────────────────────────────────────────────────────────
# Cuenta de servicio del Admin SDK (verificacion de tokens). Sin default.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
# [SOLO TESTS] Web API key de Firebase (signInWithPassword) para los scripts de
# test (scripts/_firebase-auth.js), consola-manual y el e2e. NO es la
# GOOGLE_MAPS_API_KEY. Mismo valor que el secret de GitHub. Sin default: sin ella
# los scripts tiran "Falta FIREBASE_WEB_API_KEY".
FIREBASE_WEB_API_KEY=

# ── Google Maps ─────────────────────────────────────────────────────────────
# Key con Routes API habilitada. Toda llamada a Google pasa por
# src/services/maps/. Sin key, crear / editar / estimar responden 503 (no hay
# mock ni valores inventados).
GOOGLE_MAPS_API_KEY=
# routes (Routes API, default) | legacy (Directions API: rollback temporal; se
# borra cuando Routes lleve 1 a 2 semanas estable en produccion).
MAPS_PROVIDER=routes
# Timeout de cada llamada a Google, en ms. Default 8000.
MAPS_TIMEOUT_MS=8000

# ── Redis ───────────────────────────────────────────────────────────────────
# GPS, ETA y rate limit de invitaciones. Separado por environment.
REDIS_URL=redis://localhost:6379

# ── Cloudflare R2 (remitos PDF) ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL publica del bucket: los remitos quedan en ${R2_PUBLIC_URL}/remitos/{id}.pdf
R2_PUBLIC_URL=

# ── Tarifas y reglas del viaje ──────────────────────────────────────────────
# Tarifas (ARS). Defaults 3500 / 5000 por hora en CABA y 150 / 200 por km en
# provincia (base / hora pico). 0 o basura -> default.
TARIFA_BASE_HORA_CABA=3500
TARIFA_PICO_HORA_CABA=5000
TARIFA_BASE_KM_PROVINCIA=150
TARIFA_PICO_KM_PROVINCIA=200
# Porcentaje de fee de la app que muestra el panel admin. Default 10.
FEE_PORCENTAJE=10
# Anticipacion minima de fecha_programada al crear, en minutos. Default 60. Se
# baja (o se pone en 0) en local para crear un viaje y debuggearlo ya; la fecha
# tiene que ser futura igual.
ANTICIPACION_MINIMA_MINUTOS=60
# Ventana para INICIAR un viaje: desde fecha_programada - ANTES (default 60)
# hasta fecha_programada + DESPUES (default 90). Pasado el fin, un viaje de PyME
# ASIGNADO o CONFIRMADO VENCE. El iniciar legacy usa ANTES, sin limite superior.
# Aceptan fraccionarios. LO MISMO en staging y produccion (ver arriba).
VENTANA_INICIO_ANTES_MINUTOS=60
VENTANA_INICIO_DESPUES_MINUTOS=90
# Radio (metros) para confirmar una parada / iniciar en el origen y para la
# deteccion de llegada al origen por GPS. Default 50. En Railway (staging y
# production) esta en 200: el contrato del front y el simulador (e2e/sim) lo
# documentan asi.
RADIO_CONFIRMACION_METROS=50
# Peon (carga / descarga) estimado en CADA parada, en minutos. Default 30; 0 es
# valido.
TIEMPO_PEON_MINUTOS=30
# Umbrales de puntualidad (minutos de retraso de la LLEGADA al origen).
# Defaults 30 y 120.
PUNTUALIDAD_TARDE_MINUTOS=30
PUNTUALIDAD_MUY_TARDE_MINUTOS=120
# Tope GLOBAL de paradas por viaje (crear / editar, estimar-costo, legacy y
# plantilla de series). Default 10; basura o < 2 -> 10. Conviene LO MISMO en
# staging y produccion.
MAX_PARADAS_POR_VIAJE=10
# [LEGACY] Minutos que una reserva de empresa queda sin asignar antes de volver
# sola al mercado (un timer por reserva). Default 10. Acepta fraccionarios (los
# tests usan 0.1 = 6 s).
RESERVA_TIMEOUT_MINUTOS=10

# ── GPS / ETA / desvio ──────────────────────────────────────────────────────
# Cada cuanto se EMITE el ETA a la sala del viaje, en segundos. Default 30.
ETA_EMISION_SEGUNDOS=30
# Cada cuanto se RECALCULA el ETA contra Google (1 llamada Pro), en segundos.
# Default 360.
ETA_RECALCULO_SEGUNDOS=360
# Sin pings GPS durante este tiempo, el emisor de ETA se apaga solo. Default 300.
ETA_EMISOR_IDLE_SEGUNDOS=300
# Distancia (metros) a la ruta planeada a partir de la cual hay desvio. Default 300.
DESVIO_UMBRAL_METROS=300
# Minimo entre dos recalculos de ruta por desvio, en segundos. Default 120.
RUTA_RECALCULO_COOLDOWN_SEGUNDOS=120
# Parada sospechosa: velocidad (km/h) por debajo de la cual se cuenta como
# detenido y minutos detenido para alertar. Defaults 3 y 5.
PARADA_SOSPECHOSA_VELOCIDAD_KMH=3
PARADA_SOSPECHOSA_MINUTOS=5

# ── Cierre sin "Salir" y deteccion de salida (Tarea 5) ──────────────────────
# Deteccion de salida de una parada por GPS: a mas de SALIDA_DETECCION_METROS de
# la parada durante SALIDA_DETECCION_SEGUNDOS seguidos (con la llegada ya
# confirmada). Defaults 500 y 240. Basura o <= 0 -> default.
SALIDA_DETECCION_METROS=500
SALIDA_DETECCION_SEGUNDOS=240
# Si la hora prevista de fin (llegada a la ultima + peon estimado) cae despues
# del fin del dia (23:59:59 AR del dia de inicio), el cierre automatico es la
# hora prevista + estos minutos. Default 120.
CIERRE_EXTENSION_MINUTOS=120

# ── Invitaciones (PyMEs, miembros, choferes) ────────────────────────────────
# Secreto del HMAC-SHA256 de los codigos (en la base nunca queda el codigo en
# claro). SIN default: sin el, el server arranca y los endpoints de invitaciones
# dan 503. LO MISMO en staging y produccion. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITACION_SECRETO=
# Horas de vida de un codigo. Default 72.
INVITACION_VIGENCIA_HORAS=72
# Rate limit del canje, por usuario Y por IP, en Redis: INTENTOS_MAX intentos
# cada VENTANA_MINUTOS. Defaults 5 y 15. Sin Redis se deja pasar.
INVITACION_INTENTOS_MAX=5
INVITACION_VENTANA_MINUTOS=15
# PyMEs ACTIVAS por cuenta CLIENTE. Default 1.
MAX_ORGANIZACIONES_POR_USUARIO=1

# ── Lugares y series ────────────────────────────────────────────────────────
# Estimaciones a Google en vuelo a la vez al crear una serie. Default 4.
SERIE_CONCURRENCIA_MAPS=4
# Tope TOTAL de las estimaciones de una serie, en ms. Default 60000. Si se pasa
# -> 503 y no se crea nada.
SERIE_TIMEOUT_MS=60000

# ── Seguridad y monitoreo (Tarea 6) ────────────────────────────────────────
# Origenes web permitidos (CORS de Express y de socket.io), separados por coma,
# sin barra final. Un `*` reemplaza UNA etiqueta del host (previews):
#   CORS_ORIGINS=https://app.fleter.com.ar,https://*.vercel.app
# Sin la variable: se acepta cualquier origen (igual que antes) y el server avisa
# al arrancar. Un request SIN header Origin (mobile, curl, simulador) pasa siempre.
# Se lee al ARRANCAR. Antes de cargarla en production, probar en staging que la
# app mobile se conecte por socket (si manda un Origin, allowRequest lo rechaza).
# CORS_ORIGINS=
# Saltos de proxy delante de la app (`trust proxy` de Express y la IP del
# handshake de sockets). Default 1 (el proxy de Railway). Se lee al arrancar.
TRUST_PROXY=1
# Rate limit en Redis (sin queries a la DB). Default PRENDIDO; '0' o 'false' lo
# apagan: [SOLO TESTS] / local para correr suites sueltas contra npm run dev (los
# servers efimeros y el runner de regresion ya lo apagan solos). Sin Redis deja
# pasar (falla abierta). 429 con Retry-After.
RATE_LIMIT_HABILITADO=1
# Limites: _MAX hits por _VENTANA_SEGUNDOS. El MAX se lee en cada request; la
# ventana, al arrancar. Basura o <= 0 -> default.
#   GENERAL        por IP, todo /api (no /health)
#   REGISTRO       por IP, registro-cliente / -conductor / -gerente
#   MAPS           por usuario: crear / editar viaje, estimar-costo, POST /api/viajes
#   SERIES         por usuario: crear serie (hasta 279 llamadas Pro cada una)
#   INVITACIONES   por usuario: crear codigo (el canje usa INVITACION_*)
#   SOCKET_IP      por IP, handshake de socket.io (umbral pensado para CGNAT)
#   SOCKET_USUARIO por uid de Firebase, handshake de socket.io
RATE_LIMIT_GENERAL_MAX=600
RATE_LIMIT_GENERAL_VENTANA_SEGUNDOS=60
RATE_LIMIT_REGISTRO_MAX=20
RATE_LIMIT_REGISTRO_VENTANA_SEGUNDOS=3600
RATE_LIMIT_MAPS_MAX=60
RATE_LIMIT_MAPS_VENTANA_SEGUNDOS=600
RATE_LIMIT_SERIES_MAX=10
RATE_LIMIT_SERIES_VENTANA_SEGUNDOS=3600
RATE_LIMIT_INVITACIONES_MAX=30
RATE_LIMIT_INVITACIONES_VENTANA_SEGUNDOS=3600
RATE_LIMIT_SOCKET_IP_MAX=300
RATE_LIMIT_SOCKET_IP_VENTANA_SEGUNDOS=60
RATE_LIMIT_SOCKET_USUARIO_MAX=30
RATE_LIMIT_SOCKET_USUARIO_VENTANA_SEGUNDOS=60
# Cache en memoria de la autenticacion del handshake (verifyIdToken + usuario),
# en segundos; nunca mas alla de la expiracion del token. Default 120.
SOCKET_AUTH_CACHE_SEGUNDOS=120
# Sentry (solo errores). Sin DSN no hace nada: tests y local no mandan nada (los
# unitarios y los servers de test lo fuerzan vacio aunque este en el .env).
# environment = RAILWAY_ENVIRONMENT_NAME (o NODE_ENV), release =
# RAILWAY_GIT_COMMIT_SHA: las inyecta Railway, no se cargan.
SENTRY_DSN=

# ── Flags ───────────────────────────────────────────────────────────────────
# Marketplace dormido (default false): sus rutas dan 404. Solo 'true' o '1'
# lo prenden.
MARKETPLACE_HABILITADO=false
# Calificaciones dormidas (default false): POST /api/viajes/:id/calificacion -> 404.
CALIFICACIONES_HABILITADAS=false
# Licencia opcional en el registro del chofer (Paso B; default false: la licencia
# sigue siendo obligatoria). Solo 'true' o '1' la prenden. NO prenderla en ningun
# environment hasta que production tenga el Paso A (licencia nullable en el
# Prisma): la DB es compartida y el Prisma viejo tira al leer un conductor sin
# licencia.
LICENCIA_OPCIONAL=false

# ── Solo tests ──────────────────────────────────────────────────────────────
# [SOLO TESTS] =0 apaga los barridos de arranque (reservas, vencimiento y cierre
# automatico de viajes de PyME), que ESCRIBEN en la DB compartida. Default:
# prendidos. En Railway NO se cargan.
RESERVA_BARRIDO_ARRANQUE=1
VENCIMIENTO_BARRIDO_ARRANQUE=1
CIERRE_BARRIDO_ARRANQUE=1
# [SOLO TESTS] Limita el barrido de cierre a UNA PyME (id_organizacion). Lo usa
# test-cierre-viaje (CASO 10) para no cerrar viajes reales. Vacio = todas.
# CIERRE_BARRIDO_ID_ORGANIZACION=
# [SOLO TESTS] Si esta, el "fin del dia" del cierre automatico es el inicio del
# viaje + N segundos (test-cierre-viaje CASO 7). En Railway NUNCA.
# CIERRE_FIN_DIA_SEGUNDOS_TEST=
# [SOLO TESTS] =1 corre los casos que ESCRIBEN un conductor con licencia NULL en
# la DB compartida (test-identidad CASO 15c/15d). Activarlo recien cuando main
# tenga el Paso A desplegado en production. Vacio = salteados.
# TEST_LICENCIA_NULL=
# [SOLO TESTS] Cuenta del e2e (mismos valores que los secrets de GitHub). La
# usan el e2e y scripts/seed-cuentas-test.js.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# [SOLO TESTS] Password de admin-test@fleter.com (la cuenta ADMIN de las suites).
# Ya NO esta en el codigo. Sin ella, test-admin, test-historial-estados,
# test-identidad, test-viaje-interno y el runner de regresion no arrancan, y el
# seed saltea esa cuenta. Para rotarla: scripts/rotar-password-admin-test.js. No
# la usa el CI (no hace falta secret de GitHub).
TEST_ADMIN_PASSWORD=
# [SOLO TESTS] Se pasan por linea de comando, no van en el .env:
#   TEST_BASE_URL  server contra el que pegan las suites (default
#                  http://localhost:3000; el runner test-regresion.js la setea).
#   TEST_API_URL   URL de staging para el e2e (secret de GitHub).
#   FLETER_API     backend contra el que corre el simulador del front
#                  (e2e/sim; default staging). En CI = TEST_API_URL.
#   SUBCASOS       sub-carreras del caso 17 / 21 (protocolo de reversion).
#   EJEMPLOS_JSON  archivo donde test-viaje-interno guarda ejemplos para API.md.

# ── Scripts manuales ────────────────────────────────────────────────────────
# [SCRIPT] scripts/simular-gps.js: ID token de un conductor.
TEST_CONDUCTOR_TOKEN=
# [SCRIPT] scripts/consola-manual.js. API_URL default: el staging de Railway.
# API_URL=
# CLIENTE_EMAIL=
# CLIENTE_PASSWORD=
# CONDUCTOR_EMAIL=
# CONDUCTOR_PASSWORD=
# [SCRIPT] scripts/crear-admin.js (sin defaults; test-admin las pasa solo).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NOMBRE=
# ADMIN_APELLIDO=
# ADMIN_DNI=
