        {
          "name": "PyME crea viaje (3 paradas)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/organizaciones/{{id_org}}/viajes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "organizaciones",
                "{{id_org}}",
                "viajes"
              ]
            },
            "description": "fecha_programada = ahora + 60 min + 30 s: la anticipación mínima es 60 min y la ventana de inicio abre 60 min antes, así que se puede iniciar en ~30 s.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_pyme}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_conductor\": {{id_conductor}},\n  \"fecha_programada\": \"{{fecha_programada}}\",\n  \"paradas\": [\n    { \"lat\": {{p1_lat}}, \"lng\": {{p1_lng}}, \"direccion\": \"Plaza de Mayo, CABA\" },\n    { \"lat\": {{p2_lat}}, \"lng\": {{p2_lng}}, \"direccion\": \"Obelisco, CABA\" },\n    { \"lat\": {{p3_lat}}, \"lng\": {{p3_lng}}, \"direccion\": \"Recoleta, CABA\" }\n  ],\n  \"motivo\": \"Simulación del front (Postman)\",\n  \"descripcion\": \"Simulación de finalizar viaje\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const v = pm.response.json();",
                  "const p = v.paradas.sort((a, b) => a.orden - b.orden);",
                  "pm.collectionVariables.set(\"id_viaje\", v.id_viaje);",
                  "pm.collectionVariables.set(\"id_parada_1\", p[0].id_parada);",
                  "pm.collectionVariables.set(\"id_parada_2\", p[1].id_parada);",
                  "pm.collectionVariables.set(\"id_parada_3\", p[2].id_parada);",
                  "pm.test(\"estado ASIGNADO\", () => pm.expect(v.estado).to.eql(\"ASIGNADO\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"fecha_programada\", new Date(Date.now() + 60 * 60000 + 30000).toISOString());"
                ]
              }
            }
          ]
