                  "pm.test(\"error dice m del origen\", () => pm.expect(pm.response.json().error).to.match(/m del origen/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar en el origen → CARGANDO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/choferes/viajes/{{id_viaje}}/iniciar",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "choferes",
                "viajes",
                "{{id_viaje}}",
                "iniciar"
              ]
            },
            "description": "Si responde 400 'solo puede iniciarse a partir de las HH:MM', esperá unos segundos y reintentá (en el runner se reintenta solo).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_chofer}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"lat\": {{p1_lat_cerca}}, \"lng\": {{p1_lng}} }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const intentos = Number(pm.collectionVariables.get(\"intentos_iniciar\") || 0);",
                  "if (pm.response.code === 400 && /a partir de/.test(j.error) && intentos < 18) {",
                  "  // La ventana todavía no abrió: reintento en 10 s (solo en el Collection Runner / newman).",
                  "  pm.collectionVariables.set(\"intentos_iniciar\", intentos + 1);",
                  "  setTimeout(() => {}, 10000);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set(\"intentos_iniciar\", 0);",
                  "  pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "  pm.test(\"CARGANDO\", () => pm.expect(j.estado).to.eql(\"CARGANDO\"));",
                  "}"
                ]
              }
            }
          ]
        },
