// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Rol {
  CLIENTE
  CONDUCTOR
  GERENTE
  ADMIN
}

enum EstadoViaje {
  BUSCANDO_CONDUCTOR
  RESERVADO_POR_EMPRESA
  CONDUCTOR_ASIGNADO
  EN_CAMINO_A_ORIGEN
  CARGANDO
  EN_RUTA
  DESCARGANDO
  FINALIZADO
  CANCELADO
}

enum EstadoAfiliacion {
  PENDIENTE
  ACTIVO
}

enum TipoZona {
  CABA
  PROVINCIA
  MIXTO
}

enum TipoTransaccion {
  COBRO_INICIAL
  AJUSTE
  PENALIDAD
  REEMBOLSO
}

enum EstadoTransaccion {
  PENDIENTE
  PROCESADO
  FALLIDO
  REEMBOLSADO
}

enum EstadoParada {
  PENDIENTE
  ENTREGADO
}

enum TipoCondicion {
  FRAGIL
  REFRIGERADO
  CARGA_PESADA
  PELIGROSO
  VOLUMINOSO
}

// ─────────────────────────────────────────────
// USUARIO BASE
// ─────────────────────────────────────────────

model Usuario {
  id_usuario     Int      @id @default(autoincrement())
  firebase_uid   String   @unique
  // firebase_uid es el identificador que devuelve Firebase al registrar un usuario.
  // NO hay campo contrasena — Firebase es dueño de las credenciales.
  nombre         String
  apellido       String
  dni            String   @unique
  email          String   @unique
  telefono       String?
  rol            Rol
  fecha_registro DateTime @default(now())

  cliente          Cliente?
  conductor        Conductor?
  empresas_gerente Empresa[]
  metodos_pago     MetodoPago[]
  viajes_cancelados_por_admin Viaje[] @relation("ViajesCanceladosPorAdmin")

  @@map("usuarios")
}

// ─────────────────────────────────────────────
// CLIENTE
// ─────────────────────────────────────────────

model Cliente {
  id_cliente          Int     @id @default(autoincrement())
  id_usuario          Int     @unique
  cuit                String?
  nombre_empresa      String?
  direccion_principal String?

  usuario        Usuario        @relation(fields: [id_usuario], references: [id_usuario])
  viajes         Viaje[]
  calificaciones Calificacion[]

  @@map("clientes")
}

// ─────────────────────────────────────────────
// CONDUCTOR
// ─────────────────────────────────────────────

model Conductor {
  id_conductor         Int      @id @default(autoincrement())
  id_usuario           Int      @unique
  nro_licencia         String
  licencia_vencimiento DateTime
  calificacion_promedio Float   @default(0)

  usuario             Usuario             @relation(fields: [id_usuario], references: [id_usuario])
  conductor_empresas  ConductorEmpresa[]
  conductor_vehiculos ConductorVehiculo[]
  vehiculos_propios   Vehiculo[]          @relation("VehiculoPropio")
  viajes              Viaje[]
  calificaciones      Calificacion[]

  @@map("conductores")
}

// ─────────────────────────────────────────────
// EMPRESA FLETORA
// ─────────────────────────────────────────────

model Empresa {
  id_empresa        Int      @id @default(autoincrement())
  id_gerente        Int
  cuit              String   @unique
  nombre            String
  // Codigo que el conductor ingresa para afiliarse a la empresa.
  codigo_afiliacion String   @unique
  activa            Boolean  @default(true)
  fecha_registro    DateTime @default(now())
  actualizado_en    DateTime @updatedAt

  gerente            Usuario            @relation(fields: [id_gerente], references: [id_usuario])
  conductor_empresas ConductorEmpresa[]
  vehiculos          Vehiculo[]
  viajes             Viaje[]

  @@map("empresas")
}

// ─────────────────────────────────────────────
// CONDUCTOR <-> EMPRESA  (N:N)
// ─────────────────────────────────────────────

model ConductorEmpresa {
  id_conductor_empresa Int              @id @default(autoincrement())
  id_conductor         Int
  id_empresa           Int
  // PENDIENTE: el conductor pidio afiliarse; ACTIVO: el gerente lo aprobo.
  estado               EstadoAfiliacion @default(PENDIENTE)
  fecha_alta           DateTime         @default(now())
  // Se setea al cortar el vinculo (desafiliacion por conductor o gerente).
  fecha_baja           DateTime?

  conductor Conductor @relation(fields: [id_conductor], references: [id_conductor])
  empresa   Empresa   @relation(fields: [id_empresa], references: [id_empresa])

  @@unique([id_conductor, id_empresa])
  @@map("conductor_empresa")
}

// ─────────────────────────────────────────────
// METODO DE PAGO
// Un usuario puede tener N tarjetas registradas.
// NUNCA se guardan datos reales de tarjeta — solo el token de MercadoPago.
// ─────────────────────────────────────────────

model MetodoPago {
  id_metodo       Int     @id @default(autoincrement())
  id_usuario      Int
  mp_token        String
  ultimos_digitos String
  marca           String?
  activo          Boolean @default(true)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])

  @@map("metodos_pago")
}

// ─────────────────────────────────────────────
// VEHICULO
// Dueño explicito: id_conductor (fletero individual) O id_empresa (flota),
// exactamente uno de los dos. Ambas FK son nullable; la regla "exactamente
// uno" se valida en codigo, no en el schema.
// ─────────────────────────────────────────────

model Vehiculo {
  id_vehiculo   Int    @id @default(autoincrement())
  id_empresa    Int?
  id_conductor  Int?
  patente       String @unique
  marca         String
  modelo        String
  anio          Int
  color         String
  tipo_vehiculo String

  empresa               Empresa?            @relation(fields: [id_empresa], references: [id_empresa])
  conductor_propietario Conductor?          @relation("VehiculoPropio", fields: [id_conductor], references: [id_conductor])
  conductor_vehiculos   ConductorVehiculo[]
  condiciones           CondicionVehiculo[]
  viajes                Viaje[]

  @@map("vehiculos")
}

// ─────────────────────────────────────────────
// CONDUCTOR <-> VEHICULO  (N:N)
// ─────────────────────────────────────────────

model ConductorVehiculo {
  id_conductor_vehiculo Int @id @default(autoincrement())
  id_vehiculo           Int
  id_conductor          Int

  vehiculo  Vehiculo  @relation(fields: [id_vehiculo], references: [id_vehiculo])
  conductor Conductor @relation(fields: [id_conductor], references: [id_conductor])

  @@unique([id_vehiculo, id_conductor])
  @@map("conductor_vehiculo")
}

// ─────────────────────────────────────────────
// CONDICION DEL VEHICULO
// Qué capacidades tiene el vehículo.
// ─────────────────────────────────────────────

model CondicionVehiculo {
  id_condicion Int           @id @default(autoincrement())
  id_vehiculo  Int
  condicion    TipoCondicion

  vehiculo Vehiculo @relation(fields: [id_vehiculo], references: [id_vehiculo])

  @@unique([id_vehiculo, condicion])
  @@map("condicion_vehiculo")
}

// ─────────────────────────────────────────────
// CONDICION REQUERIDA POR EL VIAJE
// Qué capacidades necesita el viaje.
// El sistema cruza esta tabla con CondicionVehiculo para filtrar conductores elegibles.
// ─────────────────────────────────────────────

model CondicionRequerida {
  id_condicion_req Int           @id @default(autoincrement())
  id_viaje         Int
  condicion        TipoCondicion

  viaje Viaje @relation(fields: [id_viaje], references: [id_viaje])

  @@unique([id_viaje, condicion])
  @@map("condicion_requerida")
}

// ─────────────────────────────────────────────
// VIAJE
// ─────────────────────────────────────────────

model Viaje {
  id_viaje            Int         @id @default(autoincrement())
  id_cliente          Int
  id_conductor        Int?
  id_vehiculo         Int?
  id_empresa          Int?
  zona                TipoZona
  tarifa_hora         Float?
  tarifa_km           Float?
  distancia_provincia Float?
  tiempo_capital      Float?
  // Duracion total estimada de la ruta (Google Distance Matrix), en HORAS.
  // Es el mismo tiempo_horas que costo.service usa para estimar el precio: se
  // persiste al crear el viaje para no tener que volver a pedirlo a Google en
  // cada lectura del detalle. La API lo expone convertido a MINUTOS enteros
  // (duracion_estimada) — ver duracion.service.js.
  duracion_estimada_horas Float?
  fecha_programada    DateTime
  descripcion         String?
  estado              EstadoViaje @default(BUSCANDO_CONDUCTOR)
  fecha_inicio        DateTime?
  // COLUMNA MUERTA. Nadie la escribe ni la lee desde que la puntualidad pasa a
  // medirse en la LLEGADA al origen y a calcularse en el read (ver
  // puntualidad.service.js). Las respuestas de la API traen un campo con este
  // MISMO nombre que es otra cosa: el valor calculado. Los valores viejos de
  // esta columna se midieron en la SALIDA hacia el origen y no son comparables.
  // Queda en el schema por el mismo motivo que Parada.qr_token: la DB de Neon
  // esta compartida con produccion y dropear columnas ahi es destructivo.
  puntualidad_inicio  String?
  // Momento en que el conductor LLEGO al origen (la parada de orden 1).
  // Lo setea el primer ping GPS que cae dentro de RADIO_CONFIRMACION_METROS
  // del origen mientras el viaje esta en EN_CAMINO_A_ORIGEN; si no hubo ningun
  // ping (sin señal, GPS apagado), lo rellena la transicion a CARGANDO como
  // respaldo de ultimo recurso. Es la base de la puntualidad.
  //
  // Necesita columna propia — a diferencia de duracion_real o vencido, que se
  // derivan de timestamps ya persistidos — porque el GPS es EFIMERO: vive en
  // Redis y limpiarGPS lo borra al cerrar el viaje. Si no se persiste en el
  // instante en que ocurre, se pierde para siempre.
  fecha_llegada_origen DateTime?
  // Momento en que el gerente reserva el viaje (RESERVADO_POR_EMPRESA).
  fecha_reserva       DateTime?
  // Quien apreto "Iniciar viaje": "CONDUCTOR" | "GERENTE".
  iniciado_por        String?
  precio_estimado     Float?
  precio_real         Float?
  creado_en           DateTime    @default(now())
  motivo_cancelacion     String?
  cancelado_por_admin_id Int?

  cliente          Cliente              @relation(fields: [id_cliente], references: [id_cliente])
  conductor        Conductor?           @relation(fields: [id_conductor], references: [id_conductor])
  vehiculo         Vehiculo?            @relation(fields: [id_vehiculo], references: [id_vehiculo])
  empresa          Empresa?             @relation(fields: [id_empresa], references: [id_empresa])
  cancelado_por_admin Usuario?          @relation("ViajesCanceladosPorAdmin", fields: [cancelado_por_admin_id], references: [id_usuario])
  paradas          Parada[]
  transacciones    Transaccion[]
  condiciones_req  CondicionRequerida[]
  calificacion     Calificacion?
  // Back-relation, NO una columna: no genera DDL sobre la tabla viajes.
  // La FK vive en historial_estado_viaje.
  historial_estados HistorialEstadoViaje[]

  @@map("viajes")
}

// ─────────────────────────────────────────────
// HISTORIAL DE ESTADOS DEL VIAJE
// Una fila por CADA cambio de estado, escrita por el caller que hizo el cambio.
// Ver historial-estado.service.js y la tabla de los 12 sitios en CLAUDE.md.
//
// Es la base de duracion_carga / duracion_descarga / duracion_real, que se
// calculan en el read a partir de estas filas.
// ─────────────────────────────────────────────

model HistorialEstadoViaje {
  id_historial Int         @id @default(autoincrement())
  id_viaje     Int
  estado       EstadoViaje
  fecha        DateTime    @default(now())
  // Quien lo disparo, si es identificable. SIN FK a Usuario a proposito: evita
  // tocar el modelo Usuario y evita una constraint que trabe borrados.
  // null cuando el cambio lo hizo el sistema (timer de reserva, barrido).
  id_usuario   Int?
  // CLIENTE | CONDUCTOR | GERENTE | ADMIN | SISTEMA. String y no enum, mismo
  // criterio que Viaje.iniciado_por. La lista vive en ORIGENES.
  origen       String?

  viaje Viaje @relation(fields: [id_viaje], references: [id_viaje])

  @@index([id_viaje, fecha])
  @@map("historial_estado_viaje")
}

// ─────────────────────────────────────────────
// PARADA
// ─────────────────────────────────────────────

model Parada {
  id_parada     Int          @id @default(autoincrement())
  id_viaje      Int
  orden         Int
  direccion     String
  latitud       Float
  longitud      Float
  qr_token      String       @unique @default(cuid())
  estado        EstadoParada @default(PENDIENTE)
  fecha_entrega DateTime?

  viaje Viaje @relation(fields: [id_viaje], references: [id_viaje])

  @@map("paradas")
}

// ─────────────────────────────────────────────
// TRANSACCION
// ─────────────────────────────────────────────

model Transaccion {
  id_transaccion     Int               @id @default(autoincrement())
  id_viaje           Int
  tipo               TipoTransaccion
  monto              Float
  monto_fee          Float
  monto_neto         Float
  estado             EstadoTransaccion @default(PENDIENTE)
  mp_payment_id      String?
  mp_idempotency_key String?           @unique
  creado_en          DateTime          @default(now())

  viaje Viaje @relation(fields: [id_viaje], references: [id_viaje])

  @@map("transacciones")
}

// ─────────────────────────────────────────────
// CALIFICACION
// ─────────────────────────────────────────────

model Calificacion {
  id_calificacion Int      @id @default(autoincrement())
  id_viaje        Int      @unique
  id_cliente      Int
  id_conductor    Int
  puntaje         Int
  comentario      String?
  fecha_hora      DateTime @default(now())

  viaje     Viaje     @relation(fields: [id_viaje], references: [id_viaje])
  cliente   Cliente   @relation(fields: [id_cliente], references: [id_cliente])
  conductor Conductor @relation(fields: [id_conductor], references: [id_conductor])

  @@map("calificaciones")
}
